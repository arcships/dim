# Rename to npm-publish.yml only when publishing is explicitly enabled.
name: Publish npm packages
on:
  workflow_dispatch:
    inputs:
      release_tag:
        description: Published GitHub Release tag (must not be a draft)
        required: true
        type: string
permissions:
  contents: read
concurrency:
  group: npm-publish
  cancel-in-progress: false
jobs:
  publish:
    if: ${{ github.repository == 'arcships/dim' }}
    runs-on: ubuntu-latest
    timeout-minutes: 30
    environment: npm-release
    permissions:
      contents: read
      id-token: write
    steps:
      - uses: actions/checkout@v6
        with:
          persist-credentials: false
      - uses: actions/setup-node@v6
        with:
          node-version-file: .node-version
          package-manager-cache: false
      - name: Resolve published Release and download original npm packages
        id: release
        env:
          GH_TOKEN: ${{ github.token }}
          GH_REPO: ${{ github.repository }}
          RELEASE_TAG: ${{ inputs.release_tag }}
        shell: bash
        run: |
          set -euo pipefail
          [[ "$RELEASE_TAG" =~ ^v(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)(-[0-9A-Za-z-]+(\.[0-9A-Za-z-]+)*)?$ ]]
          mkdir -p staging
          gh api "repos/$GITHUB_REPOSITORY/releases/tags/$RELEASE_TAG" > staging/github-release.json
          jq -e --arg tag "$RELEASE_TAG" '.draft == false and .published_at != null and .tag_name == $tag' staging/github-release.json > /dev/null
          source_sha=$(gh api "repos/$GITHUB_REPOSITORY/commits/refs%2Ftags%2F$RELEASE_TAG" --jq .sha)
          [[ "$source_sha" =~ ^[a-f0-9]{40}$ ]]
          {
            echo "sha=$source_sha"
            echo "id=$(jq -er .id staging/github-release.json)"
          } >> "$GITHUB_OUTPUT"
          gh release download "$RELEASE_TAG" --dir staging/npm --pattern '*.tgz' --pattern release-manifest.json
      - name: Validate published Release and publish platform packages before the wrapper
        env:
          GH_TOKEN: ${{ github.token }}
          RELEASE_ID: ${{ steps.release.outputs.id }}
          RELEASE_TAG: ${{ inputs.release_tag }}
          SOURCE_SHA: ${{ steps.release.outputs.sha }}
          NPM_CONFIG_REGISTRY: https://registry.npmjs.org
        shell: bash
        run: |
          set -euo pipefail
          gh api "repos/$GITHUB_REPOSITORY/releases/$RELEASE_ID" > staging/github-release.json
          [[ "$(gh api "repos/$GITHUB_REPOSITORY/commits/refs%2Ftags%2F$RELEASE_TAG" --jq .sha)" == "$SOURCE_SHA" ]]
          node scripts/publish-npm.mjs staging/npm "${RELEASE_TAG#v}" "$SOURCE_SHA" --publish staging/github-release.json
      - name: Record published Release provenance
        env:
          RELEASE_TAG: ${{ inputs.release_tag }}
        shell: bash
        run: |
          node --input-type=module <<'NODE'
          import { readFileSync, writeFileSync } from 'node:fs';
          const manifest = JSON.parse(readFileSync('staging/npm/release-manifest.json'));
          const release = JSON.parse(readFileSync('staging/github-release.json'));
          writeFileSync('npm-publication.json', JSON.stringify({ ...manifest, releaseId: release.id, releaseTag: process.env.RELEASE_TAG }));
          NODE
      - uses: actions/upload-artifact@v7
        with:
          name: npm-publication
          path: npm-publication.json
          if-no-files-found: error
          retention-days: 1
