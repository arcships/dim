[
  {
    "source": "workflow",
    "userFile": "workflow.json",
    "userOnly": [
      "/projectEnabled"
    ],
    "schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "definitions": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "schema": {
                "type": "string",
                "const": "dim.workflow/v1"
              },
              "name": {
                "type": "string",
                "pattern": "^[a-z0-9-]{1,64}$"
              },
              "description": {
                "type": "string"
              },
              "policy": {
                "type": "string",
                "enum": [
                  "read_only",
                  "workspace_write",
                  "full_access"
                ]
              },
              "parameters": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "pattern": "^[a-z0-9-]{1,32}$"
                    },
                    "description": {
                      "type": "string"
                    },
                    "required": {
                      "type": "boolean"
                    },
                    "default": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "name"
                  ],
                  "additionalProperties": false
                }
              },
              "steps": {
                "minItems": 1,
                "maxItems": 32,
                "type": "array",
                "items": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "stage": {
                          "type": "object",
                          "properties": {
                            "id": {
                              "type": "string",
                              "pattern": "^[a-z0-9-]{1,32}$"
                            },
                            "prompt": {
                              "type": "string"
                            },
                            "agent": {
                              "type": "string",
                              "minLength": 1
                            },
                            "model": {
                              "type": "object",
                              "properties": {
                                "providerId": {
                                  "type": "string",
                                  "minLength": 1
                                },
                                "modelId": {
                                  "type": "string",
                                  "minLength": 1
                                }
                              },
                              "required": [
                                "providerId",
                                "modelId"
                              ],
                              "additionalProperties": false
                            }
                          },
                          "required": [
                            "id",
                            "prompt"
                          ],
                          "additionalProperties": false
                        }
                      },
                      "required": [
                        "stage"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "parallel": {
                          "minItems": 2,
                          "maxItems": 8,
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "id": {
                                "type": "string",
                                "pattern": "^[a-z0-9-]{1,32}$"
                              },
                              "prompt": {
                                "type": "string"
                              },
                              "agent": {
                                "type": "string",
                                "minLength": 1
                              },
                              "model": {
                                "type": "object",
                                "properties": {
                                  "providerId": {
                                    "type": "string",
                                    "minLength": 1
                                  },
                                  "modelId": {
                                    "type": "string",
                                    "minLength": 1
                                  }
                                },
                                "required": [
                                  "providerId",
                                  "modelId"
                                ],
                                "additionalProperties": false
                              }
                            },
                            "required": [
                              "id",
                              "prompt"
                            ],
                            "additionalProperties": false
                          }
                        }
                      },
                      "required": [
                        "parallel"
                      ],
                      "additionalProperties": false
                    }
                  ]
                }
              }
            },
            "required": [
              "schema",
              "name",
              "description",
              "steps"
            ],
            "additionalProperties": false
          }
        },
        "projectEnabled": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "boolean"
            }
          }
        },
        "max_concurrent_runs": {
          "default": 4,
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "max_concurrent_stages": {
          "default": 4,
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false
    }
  }
]
